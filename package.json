{
  "name": "flowassert",
  "version": "0.1.0-alpha.2",
  "description": "Local automation test workbench for Android and iOS, with readable flows, explicit assertions, retained evidence, and MCP integration.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    "./application": {
      "types": "./lib/application.d.ts",
      "default": "./lib/application.js"
    },
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./mcp": {
      "types": "./lib/mcp.d.ts",
      "default": "./lib/mcp.js"
    },
    "./onboarding": {
      "types": "./lib/onboarding-cli.d.ts",
      "default": "./lib/onboarding-cli.js"
    },
    "./host-runtime": {
      "types": "./lib/host-runtime.d.ts",
      "default": "./lib/host-runtime.js"
    },
    "./viewer": {
      "types": "./lib/local-viewer-cli.d.ts",
      "default": "./lib/local-viewer-cli.js"
    },
    "./runtime-probe": "./scripts/dsh-runtime-probe.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "flowassert-mcp": "./scripts/mobile-mirror-mcp.mjs",
    "flowassert": "./scripts/mobile-mirror-cli.mjs",
    "flowassert-viewer": "./scripts/mobile-mirror-viewer.mjs"
  },
  "files": [
    "scripts/appium-loopback-guard.mjs",
    "scripts/appium-loopback-patch.mjs",
    "lib/",
    "viewer/",
    "scripts/dsh-runtime-probe.mjs",
