    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "triage:eval": "tsx scripts/triage-evaluate.ts",
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsdown",
    "check": "pnpm run typecheck && pnpm run lint:contracts && pnpm run docs:check && pnpm run test",
    "dev": "tsx scripts/dev.ts",
    "start": "tsx scripts/dev.ts",
    "lint:contracts": "tsx scripts/check-contracts.ts",
    "pack:check": "node scripts/check-package-docs.mjs",
    "prepare": "pnpm run build",
    "public:check": "node scripts/check-public-readiness.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:mcp:probe": "tsx scripts/mcp-runtime-probe.ts",
    "test:application:probe": "node scripts/plugin-runtime-probe.mjs",
    "bench:queries": "tsx scripts/workbench-query-benchmark.ts",
    "test:mcp:physical": "tsx scripts/mcp-physical-observation-probe.ts",
    "test:media:physical": "tsx scripts/physical-media-probe.ts",
    "test:agent-control:physical": "tsx scripts/agent-test-run-physical-probe.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:workbench:physical": "tsx scripts/workbench-physical-probe.ts",
    "test:authoring:physical": "tsx scripts/workbench-authoring-physical-probe.ts",
    "test:guided:physical": "tsx scripts/guided-acceptance-physical-probe.ts",
    "test:crash:physical": "tsx scripts/workbench-crash-physical-probe.ts",
    "test:device-fault:android": "tsx scripts/android-device-fault-physical-probe.ts",
    "test:device-fault:physical": "tsx scripts/android-device-fault-physical-probe.ts",
    "test:health:ios:physical": "tsx scripts/ios-health-source-physical-probe.ts",
    "test:appium-junit:physical": "tsx scripts/appium-junit-physical-probe.ts",
    "test:reliability:physical": "tsx scripts/workbench-reliability-physical-probe.ts",
    "test:workbench:benchmark": "tsx scripts/workbench-benchmark.ts",
    "test:comparison:physical": "tsx scripts/run-comparison-physical-probe.ts",
    "test:capture:physical": "tsx scripts/viewer-capture-physical-probe.ts",
    "test:video:physical": "tsx scripts/workbench-video-physical-probe.ts",
    "test:visual:pilot": "tsx scripts/web-visual-acceptance/run.mjs",
    "test:visual:gate": "node scripts/web-visual-acceptance/gate.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:render": "node scripts/render-technical-introduction.mjs && node scripts/render-faq.mjs"
  },
